# Clinical Copilot Configuration
APP_NAME=Clinical Copilot
APP_ENV=development
DEBUG=True

# LLM & Embedding Settings (optional external API; runs with local fallback if empty)
OPENAI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# Model & Device Settings
DEVICE=cuda  # auto, cuda, or cpu
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage Paths
DATA_DIR=data
GUIDELINES_DIR=data/guidelines
DATASETS_DIR=data/datasets
SAMPLE_IMAGES_DIR=data/sample_images
VECTOR_STORE_DIR=data/vector_store
